# Maintainer: ZanzyTHEbar <https://github.com/ZanzyTHEbar>
pkgname=workspace-indicator-bin
pkgver=0.5.0
pkgrel=1
pkgdesc="Zero-dependency static Wayland workspace OSD for Hyprland, Sway, Niri, and Omarchy"
arch=('x86_64' 'aarch64')
url="https://github.com/ZanzyTHEbar/workspace-indicator"
license=('MIT')
provides=('workspace-indicator')
conflicts=('workspace-indicator')
source_x86_64=("${pkgname}-${pkgver}-x86_64.tar.gz::${url}/releases/download/v${pkgver}/workspace-indicator-linux-x86_64.tar.gz")
source_aarch64=("${pkgname}-${pkgver}-aarch64.tar.gz::${url}/releases/download/v${pkgver}/workspace-indicator-linux-aarch64.tar.gz")
sha256sums_x86_64=('d0076d6b234c800c38f1f7257f321b50f72291fa985a9775fc0ef1dafa152ac1')
sha256sums_aarch64=('2d785d74f2dff0809125026731976cf990eb48c61631bfc084b9dc8e9bd092a0')

package() {
  install -Dm755 "${srcdir}/workspace-indicator" "${pkgdir}/usr/bin/workspace-indicator"
  install -Dm755 "${srcdir}/scripts/workspace-indicator-focusd" "${pkgdir}/usr/bin/workspace-indicator-focusd"
  install -Dm644 "${srcdir}/systemd/workspace-indicator.service" "${pkgdir}/usr/lib/systemd/user/workspace-indicator.service"
  # Distribution packages install in /usr/bin, unlike the per-user tarball.
  sed -i 's|ExecStart=%h/.local/bin/workspace-indicator|ExecStart=/usr/bin/workspace-indicator|' \
    "${pkgdir}/usr/lib/systemd/user/workspace-indicator.service"
  install -Dm644 "${srcdir}/hyprland/workspace-indicator.conf" "${pkgdir}/usr/share/workspace-indicator/hyprland/workspace-indicator.conf"
  install -Dm644 "${srcdir}/hyprland/workspace-indicator.lua" "${pkgdir}/usr/share/workspace-indicator/hyprland/workspace-indicator.lua"
  install -Dm755 "${srcdir}/omarchy/theme-set-hook" "${pkgdir}/usr/share/workspace-indicator/omarchy/theme-set-hook"
  install -Dm644 "${srcdir}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
