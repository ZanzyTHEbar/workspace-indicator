{
  "branches": ["main"],
  "plugins": [
    ["@semantic-release/commit-analyzer", {
      "releaseRules": [{"type": "build", "scope": "debian", "release": "patch"}]
    }],
    "@semantic-release/release-notes-generator",
    ["@semantic-release/changelog", {"changelogFile": "CHANGELOG.md"}],
    ["@semantic-release/exec", {"prepareCmd": "python3 scripts/prepare-release.py ${nextRelease.version}"}],
    ["@semantic-release/git", {
      "assets": ["Cargo.toml", "Cargo.lock", "manifest.json", "CHANGELOG.md"],
      "message": "chore(release): ${nextRelease.version}\n\n${nextRelease.notes}"
    }],
    ["@semantic-release/github", {"assets": ["workspace-indicator-linux-*.tar.gz", "dist/*.deb"]}]
  ]
}
